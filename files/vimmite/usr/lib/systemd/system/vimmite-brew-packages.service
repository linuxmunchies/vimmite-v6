[Unit]
Description=Install Vimmite-managed Homebrew formulae
Wants=network-online.target
After=brew-setup.service network-online.target
ConditionPathIsSymbolicLink=/home/linuxbrew/.linuxbrew/bin/brew
StartLimitIntervalSec=0

[Service]
Type=oneshot
# The launcher follows the shared prefix owner and drops privileges before it
# invokes Brew. Broader non-1000 support also depends on uBlue's Brew units.
ExecStart=/usr/libexec/vimmite-brew-packages
Restart=on-failure
RestartSec=2min

[Install]
WantedBy=multi-user.target
