#!/usr/bin/env bash
set -euo pipefail

if (( EUID == 0 )); then
    echo "Refusing to install AI CLIs as root. Run this command as your regular user." >&2
    exit 1
fi

readonly user_prefix="${HOME}/.local"
readonly dev_box="vimmite-dev"
readonly container_home="${HOME}/.local/share/vimmite-ai/container"
readonly staging_dir="${container_home}/.cache/vimmite-ai/installers"
readonly -a all_clis=(codex grok pi omp claude dsh opencode hermes)

if [[ -t 1 ]]; then
    readonly c_reset=$'\033[0m' c_bold=$'\033[1m' c_dim=$'\033[2m'
    readonly c_blue=$'\033[34m' c_green=$'\033[32m' c_yellow=$'\033[33m' c_red=$'\033[31m'
else
    readonly c_reset='' c_bold='' c_dim=''
    readonly c_blue='' c_green='' c_yellow='' c_red=''
fi

step_start=0
step() {
    step_start="${SECONDS}"
    printf '%s==>%s %s%s%s\n' "${c_blue}${c_bold}" "${c_reset}" "${c_bold}" "$*" "${c_reset}"
}
note() { printf '%s    %s%s\n' "${c_dim}" "$*" "${c_reset}"; }
ok() { printf '%s  ok%s %s %s(%ss)%s\n' "${c_green}${c_bold}" "${c_reset}" "$*" "${c_dim}" "$(( SECONDS - step_start ))" "${c_reset}"; }
warn() { printf '%swarn%s %s\n' "${c_yellow}${c_bold}" "${c_reset}" "$*" >&2; }
fail() { printf '%sfail%s %s\n' "${c_red}${c_bold}" "${c_reset}" "$*" >&2; }

# Every harness here is a full-screen terminal program, and every upstream
# installer draws progress bars and asks questions. Both need a real pty on
# stdin and stdout, so only fall back to --no-tty when there genuinely is no
# terminal to attach (a pipe, a cron job, the test suite).
tty_available() { [[ -t 0 && -t 1 ]]; }

container_exec() {
    mkdir -p "${container_home}"
    local -a enter_flags=(--name "${dev_box}")
    tty_available || enter_flags+=(--no-tty)
    distrobox enter "${enter_flags[@]}" -- env \
        HOME="${container_home}" XDG_CONFIG_HOME="${container_home}/.config" \
        XDG_DATA_HOME="${container_home}/.local/share" XDG_CACHE_HOME="${container_home}/.cache" \
        NPM_CONFIG_PREFIX="${container_home}/.local" \
        CARGO_HOME="${container_home}/.cargo" RUSTUP_HOME="${container_home}/.rustup" \
        BUN_INSTALL="${container_home}/.bun" UV_TOOL_DIR="${container_home}/.local/share/uv/tools" \
        UV_TOOL_BIN_DIR="${container_home}/.local/bin" \
        PATH="${container_home}/.local/bin:${container_home}/.bun/bin:${container_home}/.cargo/bin:${container_home}/.opencode/bin:${container_home}/.hermes/bin:/usr/local/bin:/usr/bin:/bin" "$@"
}

usage() {
    cat <<'EOF'
Usage: vimmite-install-ai-cli [codex|grok|pi|omp|claude|dsh|opencode|hermes] [host|container] [-- ARGS...]
       vimmite-install-ai-cli update [codex|grok|pi|omp|claude|dsh|opencode|hermes] [host|container]
       vimmite-install-ai-cli check [codex|grok|pi|omp|claude|dsh|opencode|hermes] [host|container]
       vimmite-install-ai-cli [menu|status|help]

Install an AI coding CLI into the current user's environment.

Arguments after -- are passed through to the upstream installer, for example:
  vimmite-install-ai-cli hermes container -- --skip-browser

Set VIMMITE_AI_TAG_<CLI> to pin an npm-published harness to another dist-tag
or version, for example VIMMITE_AI_TAG_DSH=latest or VIMMITE_AI_TAG_CODEX=next.
EOF
}

pause_menu() {
    read -r -p "Press Enter to return to the menu..." _ || return 1
}

choose_cli() {
    local prompt="$1"
    shift
    local selection

    if command -v ugum >/dev/null 2>&1 && [[ -t 0 ]]; then
        ugum choose "$@"
    elif command -v gum >/dev/null 2>&1 && [[ -t 0 ]]; then
        gum choose --header "${prompt}" "$@"
    else
        select selection in "$@"; do
            if [[ -n "${selection}" ]]; then
                printf '%s\n' "${selection}"
                return 0
            fi
            echo "Choose a number from the menu." >&2
        done
        return 1
    fi
}

devbox_exists() {
    command -v podman >/dev/null 2>&1 && podman container exists "${dev_box}" >/dev/null 2>&1
}

ensure_devbox() {
    if devbox_exists; then
        return 0
    fi
    [[ -t 0 ]] || {
        echo "${dev_box} is not installed. Run 'ujust vimmite-dev create' first." >&2
        return 1
    }
    read -r -p "${dev_box} is not installed. Create it now? [Y/n] " answer
    if [[ -n "${answer}" && ! "${answer}" =~ ^[Yy]$ ]]; then
        echo "No container was selected." >&2
        return 1
    fi
    /usr/libexec/vimmite-devbox create
    devbox_exists || {
        echo "${dev_box} was not created successfully." >&2
        return 1
    }
}

# npm's "latest" tag is the conservative one. Harnesses that ship their real
# work on a pre-release tag are listed here so the default install tracks the
# bleeding edge, and any of them can be overridden per invocation.
cli_npm_tag() {
    local cli="$1"
    local override_name="VIMMITE_AI_TAG_${cli^^}"
    local override="${!override_name:-}"
    if [[ -n "${override}" ]]; then
        printf '%s\n' "${override}"
        return 0
    fi
    case "${cli}" in
        dsh) printf 'alpha\n' ;;
        *) printf 'latest\n' ;;
    esac
}

download() {
    local url="$1" dest="$2"
    if tty_available; then
        curl -fL --progress-bar --retry 3 --retry-delay 2 "${url}" -o "${dest}"
    else
        curl -fsSL --retry 3 --retry-delay 2 "${url}" -o "${dest}"
    fi
}

install_npm_cli() {
    local package="$1"
    local name="$2"

    if ! command -v node >/dev/null 2>&1 || ! command -v npm >/dev/null 2>&1; then
        fail "Cannot install ${name}: both node and npm are required."
        echo "Install Node.js and npm, then run this command again." >&2
        return 1
    fi

    if ! mkdir -p "${user_prefix}/bin"; then
        fail "Cannot create ${user_prefix}/bin."
        return 1
    fi
    step "Installing ${name} for the current user"
    note "package: ${package}"
    if ! npm install --global --prefix "${user_prefix}" --no-fund --no-audit "${package}"; then
        fail "The ${name} npm installation failed."
        return 1
    fi
    ok "${name} installed in ${user_prefix}/bin"
    echo "If the command is not found, add ${user_prefix}/bin to PATH and open a new shell."
}

install_npm_cli_container() {
    local package="$1"
    local name="$2"
    ensure_devbox || return 1
    step "Installing ${name} inside ${dev_box}"
    note "package: ${package}"
    note "npm prints its own progress below; a cold install can take a few minutes."
    container_exec bash -c '
set -euo pipefail
if ! command -v npm >/dev/null 2>&1; then
    echo "npm is missing inside the container. Rebuild it with: ujust vimmite-dev update" >&2
    exit 1
fi
mkdir -p "$HOME/.local/bin"
npm install --global --prefix "$HOME/.local" --no-fund --no-audit "$1"
' _ "${package}"
    ok "${name} is available inside ${dev_box} under ${container_home}"
}

install_script_cli() {
    local url="$1"
    local name="$2"
    local shell="$3"
    shift 3

    (
        installer=""
        trap 'rm -f -- "${installer:-}"' EXIT

        if ! installer="$(mktemp)"; then
            fail "Could not create a temporary file for the ${name} installer."
            exit 1
        fi
        step "Downloading the ${name} installer"
        if ! download "${url}" "${installer}"; then
            fail "Could not download the ${name} installer."
            exit 1
        fi
        ok "Installer downloaded"
        step "Running the ${name} installer"
        note "everything below is the ${name} installer's own output."
        if ! "${shell}" "${installer}" "$@"; then
            fail "The ${name} installer failed."
            exit 1
        fi
        ok "${name} installed"
    )
}

install_script_cli_container() {
    local url="$1"
    local name="$2"
    local shell="$3"
    shift 3
    ensure_devbox || return 1
    mkdir -p "${staging_dir}"
    # An interrupted run cannot fire its cleanup trap, so sweep what it left.
    find "${staging_dir}" -maxdepth 1 -type f -name 'installer.*' -mmin +60 -delete 2>/dev/null || true
    (
        installer=""
        trap 'rm -f -- "${installer:-}"' EXIT
        # Stage the installer inside the container home rather than piping it in
        # on stdin. distrobox mounts this path at the same location, so the box
        # runs it by path and stdin stays attached to the terminal, which is
        # what upstream installers use for prompts and progress bars.
        installer="$(mktemp "${staging_dir}/installer.XXXXXX")"
        step "Downloading the ${name} installer"
        download "${url}" "${installer}"
        chmod 0755 "${installer}"
        ok "Installer downloaded"
        step "Running the ${name} installer inside ${dev_box}"
        note "everything below is the ${name} installer's own output."
        note "large downloads and git fetches can run for several minutes."
        container_exec "${shell}" "${installer}" "$@"
        ok "${name} installed inside ${dev_box}"
    )
}

record_container_install() {
    local cli="$1"
    mkdir -p "${container_home}/installed" "${HOME}/.local/bin"
    touch "${container_home}/installed/${cli}"
    {
        printf '#!/usr/bin/env bash\n'
        printf 'exec /usr/libexec/vimmite-install-ai-cli run-container %q "$@"\n' "${cli}"
    } > "${HOME}/.local/bin/${cli}-container"
    chmod 0755 "${HOME}/.local/bin/${cli}-container"
    echo "Launch with: ${cli}-container"
}

install_cli() {
    local cli="$1"
    local target="${2:-host}"
    # Only what follows the CLI and target is meant for the upstream installer;
    # a bare `shift 2` would leave them in place when they are the only args.
    if (( $# > 2 )); then shift 2; else set --; fi
    local -a installer_args=("$@")

    case "${target}" in
        host|container) ;;
        *) echo "Unknown installation target: ${target}" >&2; return 2 ;;
    esac

    local package
    case "${cli}" in
        codex)
            package="@openai/codex@$(cli_npm_tag codex)"
            if [[ "${target}" == container ]]; then install_npm_cli_container "${package}" 'Codex'; else install_npm_cli "${package}" 'Codex'; fi
            ;;
        grok)
            if [[ "${target}" == container ]]; then install_script_cli_container 'https://x.ai/cli/install.sh' 'Grok Build' bash "${installer_args[@]+"${installer_args[@]}"}"; else install_script_cli 'https://x.ai/cli/install.sh' 'Grok Build' bash "${installer_args[@]+"${installer_args[@]}"}"; fi
            ;;
        pi)
            if [[ "${target}" == container ]]; then install_script_cli_container 'https://pi.dev/install.sh' 'Pi' sh "${installer_args[@]+"${installer_args[@]}"}"; else install_script_cli 'https://pi.dev/install.sh' 'Pi' sh "${installer_args[@]+"${installer_args[@]}"}"; fi
            ;;
        omp)
            if [[ "${target}" == container ]]; then install_script_cli_container 'https://omp.sh/install' 'Oh My Pi' sh "${installer_args[@]+"${installer_args[@]}"}"; else install_script_cli 'https://omp.sh/install' 'Oh My Pi' sh "${installer_args[@]+"${installer_args[@]}"}"; fi
            ;;
        claude)
            if [[ "${target}" == container ]]; then install_script_cli_container 'https://claude.ai/install.sh' 'Claude Code' bash "${installer_args[@]+"${installer_args[@]}"}"; else install_script_cli 'https://claude.ai/install.sh' 'Claude Code' bash "${installer_args[@]+"${installer_args[@]}"}"; fi
            ;;
        dsh)
            package="@deepseek-ai/dsh@$(cli_npm_tag dsh)"
            if [[ "${target}" == container ]]; then install_npm_cli_container "${package}" 'DeepSeek Harness'; else install_npm_cli "${package}" 'DeepSeek Harness'; fi
            echo "Launch it with: dsh web"
            ;;
        opencode)
            if [[ "${target}" == container ]]; then install_script_cli_container 'https://opencode.ai/install' 'OpenCode' bash "${installer_args[@]+"${installer_args[@]}"}"; else install_script_cli 'https://opencode.ai/install' 'OpenCode' bash "${installer_args[@]+"${installer_args[@]}"}"; fi
            ;;
        hermes)
            if [[ "${target}" == container ]]; then install_script_cli_container 'https://hermes-agent.nousresearch.com/install.sh' 'Hermes Agent' bash "${installer_args[@]+"${installer_args[@]}"}"; else install_script_cli 'https://hermes-agent.nousresearch.com/install.sh' 'Hermes Agent' bash "${installer_args[@]+"${installer_args[@]}"}"; fi
            ;;
        *)
            echo "Unknown AI CLI: ${cli}" >&2
            usage >&2
            return 2
            ;;
    esac
    if [[ "${target}" == container ]]; then
        record_container_install "${cli}"
    fi
}

# npm publishes an exact version behind each selected dist-tag. Compare that
# version with Vimmite's installation before running npm's global installer.
update_cli() {
    local cli="$1" target="$2" mode="${3:-update}" package_name package_spec installed_version available_version package_path
    case "${cli}" in
        codex) package_name='@openai/codex' ;;
        dsh) package_name='@deepseek-ai/dsh' ;;
        grok|pi|omp|claude|opencode|hermes)
            note "${cli} (${target}): upstream installer does not provide a reliable version check."
            [[ "${mode}" == check ]] && return 0
            install_cli "${cli}" "${target}"
            return
            ;;
        *) echo "Unknown AI CLI: ${cli}" >&2; return 2 ;;
    esac
    package_spec="${package_name}@$(cli_npm_tag "${cli}")"
    if [[ "${target}" == container ]]; then
        ensure_devbox || return 1
        package_path="${container_home}/.local/lib/node_modules/${package_name}/package.json"
        installed_version="$(container_exec node -e 'try { console.log(require(process.argv[1]).version) } catch (_) {}' "${package_path}")" || return 1
        available_version="$(container_exec npm view "${package_spec}" version)" || return 1
    elif [[ "${target}" == host ]]; then
        package_path="${user_prefix}/lib/node_modules/${package_name}/package.json"
        installed_version="$(node -e 'try { console.log(require(process.argv[1]).version) } catch (_) {}' "${package_path}")" || return 1
        available_version="$(npm view "${package_spec}" version)" || return 1
    else
        echo "Unknown installation target: ${target}" >&2
        return 2
    fi
    [[ -n "${available_version}" ]] || { fail "Could not determine the current version of ${package_spec}."; return 1; }
    if [[ "${installed_version}" == "${available_version}" ]]; then
        note "${cli} (${target}) is up to date at ${installed_version}."
        return 0
    fi
    note "${cli} (${target}): ${installed_version:-not managed} -> ${available_version}"
    [[ "${mode}" == check ]] && return 0
    install_cli "${cli}" "${target}"
}

# Harnesses land in whichever directory their installer prefers, so look
# wherever container_exec puts them on PATH rather than in ~/.local/bin alone.
container_binary() {
    local cli="$1" dir
    for dir in .local/bin .bun/bin .cargo/bin .opencode/bin .hermes/bin; do
        if [[ -e "${container_home}/${dir}/${cli}" ]]; then
            printf '%s\n' "${container_home}/${dir}/${cli}"
            return 0
        fi
    done
    return 1
}

status() {
    local cli state host_path
    printf '%sAI coding harnesses%s\n' "${c_bold}" "${c_reset}"
    printf '%-10s %-30s %s\n' 'CLI' "in ${dev_box}" 'on host'
    for cli in "${all_clis[@]}"; do
        state='-'
        [[ -e "${container_home}/installed/${cli}" ]] && state='recorded, binary missing'
        if container_binary "${cli}" >/dev/null; then
            if [[ -x "${HOME}/.local/bin/${cli}-container" ]]; then
                state="installed (${cli}-container)"
            else
                state='installed, launcher missing'
            fi
        fi
        host_path="$(command -v "${cli}" 2>/dev/null || true)"
        printf '%-10s %-30s %s\n' "${cli}" "${state}" "${host_path:--}"
    done
    if ! devbox_exists; then
        warn "${dev_box} is not present; run 'ujust vimmite-dev create'."
    fi
}

menu() {
    local selection
    local -a choices=(
        'Install or update Codex'
        'Install or update Grok Build'
        'Install or update Pi'
        'Install or update OMP (Oh My Pi)'
        'Install or update Claude Code'
        'Install or update DSH (DeepSeek Harness)'
        'Install or update OpenCode'
        'Install or update Hermes Agent'
        'Show installed harnesses'
        'Quit'
    )

    if [[ ! -t 0 || ! -t 1 ]]; then
        echo "The AI CLI installer menu requires an interactive terminal." >&2
        echo "Pass one of codex, grok, pi, omp, claude, dsh, opencode, or hermes directly." >&2
        return 1
    fi

    while true; do
        selection="$(choose_cli 'Install an AI CLI' "${choices[@]}")" || return 0
        case "${selection}" in
            'Install or update Codex') install_cli_with_target codex ;;
            'Install or update Grok Build') install_cli_with_target grok ;;
            'Install or update Pi') install_cli_with_target pi ;;
            'Install or update OMP (Oh My Pi)') install_cli_with_target omp ;;
            'Install or update Claude Code') install_cli_with_target claude ;;
            'Install or update DSH (DeepSeek Harness)') install_cli_with_target dsh ;;
            'Install or update OpenCode') install_cli_with_target opencode ;;
            'Install or update Hermes Agent') install_cli_with_target hermes ;;
            'Show installed harnesses') status ;;
            Quit) return 0 ;;
        esac
        pause_menu || return 0
    done
}

install_cli_with_target() {
    local cli="$1"
    local selection target
    selection="$(choose_cli "Where should ${cli} be installed?" \
        'Distrobox container: vimmite-dev (recommended)' \
        'Host installation' \
        'Back')" || return 0
    case "${selection}" in
        'Distrobox container'*) target=container ;;
        'Host installation') target=host ;;
        *) return 0 ;;
    esac
    install_cli "${cli}" "${target}"
}

case "${1:-menu}" in
    run-container) shift; ensure_devbox; container_exec "$@" ;;
    check|update)
        [[ $# == 3 ]] || { usage >&2; exit 2; }
        update_cli "$2" "$3" "$1"
        ;;
    menu) menu ;;
    status) status ;;
    help|-h|--help) usage ;;
    codex|grok|pi|omp|claude|dsh|opencode|hermes)
        cli="$1"
        shift
        target=host
        if (( $# > 0 )) && [[ "$1" != -- ]]; then
            target="$1"
            shift
        fi
        if (( $# > 0 )); then
            [[ "$1" == -- ]] || { echo "Unexpected extra arguments: $*" >&2; exit 2; }
            shift
        fi
        install_cli "${cli}" "${target}" "$@"
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
